# Скопируйте этот файл в .env и заполните. Файл .env в git НЕ попадает.

# --- Сайт ---
# Длинная случайная строка. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Пароль для входа в CRM (/admin)
ADMIN_PASSWORD=
# Публичный адрес сайта, без слэша в конце. Нужен для ссылок в Telegram и sitemap
SITE_URL=
# Стиль сайта: classic («Классика») или bright («Яркая»)
SITE_SKIN=classic
# Показывать посетителям переключатель стилей (1 — да, 0 — нет)
SKIN_SWITCHER=1
# Сайт стоит за nginx или другим прокси? Тогда 1
TRUST_PROXY=0

# --- Агентство: эти данные видны на сайте ---
AGENCY_NAME=Смета за минуту
AGENCY_PHONE=+7 (000) 000-00-00
AGENCY_EMAIL=hello@example.ru
AGENCY_TELEGRAM=@your_agency
# За сколько минут менеджер перезванивает в рабочее время
RESPONSE_MINUTES=15

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Чат менеджеров (у групп id начинается с -100). Как узнать — в README
TELEGRAM_CHAT_ID=
# Общий секрет сайта и бота. Сгенерировать так же, как SECRET_KEY
INTERNAL_API_TOKEN=
# Где бот ищет сайт. При запуске через docker compose подставится само
SITE_API_URL=http://127.0.0.1:5000
# Необязательно: id менеджеров через запятую — им можно писать боту в личку
MANAGER_IDS=

# --- Защита формы от спама ---
LEAD_RATE_LIMIT=5
LEAD_RATE_WINDOW=600
LEAD_MIN_SECONDS=3
